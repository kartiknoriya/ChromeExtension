{
     "manifest_version":3,
     "name": "AI Text Helper",
     "description": "Select text from any website and explain it using Ai",
     "version": "1.0.0",
     "action":{
          "default_popup":"index.html",
          "default_title": "AI Helper"
     },

     "permissions": [
        "storage",
        "activeTab",
        "scripting"   

    ],

     "background" :{
         "service_worker": "background.js"

     },

     "content_scripts": [
         {
             "matches":[
                 "<all_urls>"
             ],
             "js":[
                 "content.js"
            ]
         }
        ]


}